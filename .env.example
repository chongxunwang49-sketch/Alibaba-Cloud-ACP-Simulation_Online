# Docker Compose 部署配置模板
# 服务器上执行 deploy.sh 会自动复制为 .env 并生成随机 Mongo 密码
# 不要提交 .env；密码只用十六进制/字母数字，避免 URI 转义问题

# 前端对外端口（安全组只放行这个端口）
WEB_PORT=80

# 时区
TZ=Asia/Shanghai

# MongoDB 容器内认证（仅内部网络可访问，不映射宿主机端口）
MONGO_ROOT_USERNAME=acpadmin
MONGO_ROOT_PASSWORD=change-me-please
MONGODB_DATABASE=acp

# 构建时 npm registry；国内 ECS 可改成 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
