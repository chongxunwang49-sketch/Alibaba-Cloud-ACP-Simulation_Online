# 服务监听
PORT=3004
HOST=0.0.0.0
NODE_ENV=production

# MongoDB（本机 mongod，仅监听 127.0.0.1）
MONGODB_URI=mongodb://127.0.0.1:27017/acp

# 反向代理：Nginx 与 Node 同机，开启后从 X-Forwarded-For 取真实 IP
TRUST_PROXY=1

# 首次启动自动导入题库（questions.array.json），已存在则跳过
SEED_ON_START=1
# 强制用文件覆盖题库（改题后手动执行一次，或 npm run export:bank + 重启）
SEED_FORCE=0

# 前后端同域部署时留空；本地 Vite 调试可设为 http://127.0.0.1:5173
CORS_ORIGIN=

# 统计按天聚合所用时区
APP_TIMEZONE=Asia/Shanghai

# 压测/本地联调可临时关闭限流
RATE_LIMIT_DISABLED=0
